{
  "name": "obsidian-countdown",
  "version": "1.1.7",
  "description": "A countdown timer plugin for Obsidian using code fence syntax",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "install-to-vault": "node scripts/install-to-vault.mjs",
    "deploy": "npm run build && node scripts/install-to-vault.mjs"
  },
  "keywords": [
    "obsidian",
    "countdown",
    "timer"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "9.30.1",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.0.10",
    "esbuild": "0.27.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-obsidianmd": "0.1.9",
    "globals": "17.1.0",
    "jest": "^30.2.0",
    "jiti": "2.6.1",
    "prettier": "^3.8.1",
    "ts-jest": "^29.1.2",
    "tslib": "2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.53.1"
  },
  "dependencies": {
    "js-yaml": "^4.1.1",
    "obsidian": "latest"
  }
}
