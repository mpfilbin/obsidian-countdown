{
  "name": "obsidian-countdown",
  "version": "1.3.0",
  "description": "A countdown timer plugin for Obsidian using code fence syntax",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "release": "bash scripts/release.sh"
  },
  "keywords": [
    "obsidian",
    "countdown",
    "timer"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.2.3",
    "esbuild": "0.28.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-obsidianmd": "0.6.0",
    "globals": "17.14.0",
    "jest": "^30.2.0",
    "jiti": "2.7.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.1.2",
    "tslib": "2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.55.0"
  },
  "dependencies": {
    "js-yaml": "^4.3.2",
    "obsidian": "latest"
  }
}
